# TradingAgents Environment Configuration
# Copy this to .env and fill in your values

# === Required API Keys ===

# DeepSeek API Key (required for default LLM agents)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# REST API authentication and browser origins
TRADINGAGENTS_API_KEY=replace_with_a_long_random_secret
TRADINGAGENTS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI API Key (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# FinnHub API Key (required for news data)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca Broker (required for fail-closed pre-flight risk checks)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Controlled broker execution (generate a unique value with: openssl rand -hex 32)
TRADINGAGENTS_EXECUTION_SIGNING_KEY=
TRADINGAGENTS_EXECUTION_DB=.tradingagents/execution.sqlite3

# === Optional API Keys ===

# Polygon.io (for real-time data)
POLYGON_API_KEY=

# Reddit API (for sentiment data)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google AI (alternative LLM provider)
GOOGLE_API_KEY=

# Anthropic (alternative LLM provider)
ANTHROPIC_API_KEY=

# === LLM Configuration ===

# Deep thinking model (for complex decisions)
DEEP_THINK_LLM=deepseek-v4-flash

# Quick thinking model (for analysts)
QUICK_THINK_LLM=deepseek-v4-flash

# LLM Provider: deepseek, openai, google, anthropic
LLM_PROVIDER=deepseek

# Backend URL (default: DeepSeek OpenAI-compatible API)
BACKEND_URL=https://api.deepseek.com

# === Trading Configuration ===

# Maximum debate rounds
MAX_DEBATE_ROUNDS=1

# Maximum risk discussion rounds
MAX_RISK_DISCUSS_ROUNDS=1

# Use online tools (true/false)
ONLINE_TOOLS=true

# === Risk Limits ===

# Maximum position per symbol (percentage)
RISK_MAX_POSITION_PER_SYMBOL=0.10

# Maximum daily trades
RISK_MAX_DAILY_TRADES=50

# Maximum trades per rolling broker hour
RISK_MAX_HOURLY_TRADES=10

# Single-order notional bounds (USD)
RISK_MAX_TRADE_SIZE_USD=100000

# Maximum portfolio exposure (percentage)
RISK_MAX_PORTFOLIO_EXPOSURE=0.80

# Minimum cash reserve (percentage)
RISK_MIN_CASH_RESERVE=0.20

# Default stop loss (percentage)
RISK_DEFAULT_STOP_LOSS_PCT=0.05

# Minimum API quota reserve
RISK_MIN_API_QUOTA_RESERVE=100

# Maximum account-limit utilization score (0-100)
RISK_MAX_RISK_SCORE=70

# === Server Configuration ===

# API Server port
API_PORT=8000

# Web UI port
WEB_PORT=8000

# Enable debug mode
DEBUG=false

# === Data Configuration ===

# Data directory (for cached data)
TRADINGAGENTS_DATA_DIR=

# Results directory
TRADINGAGENTS_RESULTS_DIR=./results

# === Logging ===

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
